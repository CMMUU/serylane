{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serylane",
  "version": "0.7.13",
  "identifier": "com.cmmuu.mihomodesktop",
  "build": {
    "beforeDevCommand": "npm run core:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run core:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Serylane",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "wix": {
        "upgradeCode": "3dc8b957-21f1-51b9-ab4c-df67ce49b53d",
        "fragmentPaths": [
          "installer/login-cleanup.wxs"
        ],
        "componentGroupRefs": [
          "SerylaneLoginCleanup"
        ]
      },
      "nsis": {
        "template": "installer/installer.nsi"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchDaemons/com.cmmuu.mihomodesktop.tun-helper.plist": "helper/com.cmmuu.mihomodesktop.tun-helper.plist"
      }
    },
    "externalBin": [
      "binaries/mihomo"
    ],
    "resources": {
      "../third-party/Mihomo-LICENSE.txt": "licenses/Mihomo-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "serylane",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRkUwQzkzQTVDRjgwNwpSV1FIK0Z3NnllQXZBb0hQdiszYzJURHlwRVREbW1jMHV2VHNPY3AxT3hJNzBVRW9ZckZDWno0Sgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
